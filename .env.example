# Database Configuration (PostgreSQL or local SQLite)
DATABASE_URL=sqlite:///./rag_citations.db
# For PostgreSQL: DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_citations

# Qdrant Vector DB Configuration
QDRANT_STORAGE_PATH=./data/qdrant
# For Remote Qdrant: QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Uploads Directory
UPLOAD_DIR=./data/uploads

# LLM Providers Configuration
# Supported options: "gemini", "openai", "groq", "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Retrieval & Chunking Defaults
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=10
DEFAULT_FINAL_TOP_K=4

